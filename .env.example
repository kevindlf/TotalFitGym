# =============================================================================
# Total Fit — variables de entorno
# Copiá este archivo a `.env.local` y completá los valores reales.
# `.env.local` está en .gitignore: NUNCA se commitea.
# =============================================================================

# --- Base de datos (PostgreSQL) ---------------------------------------------
# Desarrollo local (instancia PostgreSQL 18 de esta máquina).
# Reemplazá TU_PASSWORD por la password del usuario `postgres`.
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/totalfit_dev?schema=public"

# Conexión directa (sin pooler), SOLO para migraciones. En local no hace falta:
# dejala vacía y el CLI usa DATABASE_URL.
# En Supabase (Fase 2): DATABASE_URL apunta al pooler (puerto 6543) y DIRECT_URL
# a la conexión directa (puerto 5432), que es la que necesitan las migraciones.
DIRECT_URL=""

# --- Auth (NextAuth v5) -----------------------------------------------------
# Generar con: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Reglas de negocio ------------------------------------------------------
# Días de anticipación para el estado PRÓXIMO A VENCER (amarillo en recepción).
DIAS_PROXIMO_A_VENCER="7"

# Ventana de pago: días DESPUÉS del vencimiento en los que el socio todavía
# entra, aunque ya le corresponda pagar (naranja en recepción).
# 0 = comportamiento estricto (vencido = rojo, sin excepciones).
# 5 = "pagás el 1° y tenés hasta el 5 para renovar".
DIAS_DE_GRACIA="0"

# --- Rutinas ----------------------------------------------------------------
# Apagado: el gimnasio reparte las rutinas con su propio QR. El código está
# entero y probado; poner "true" lo devuelve a la ficha del socio y al portal.
RUTINAS_HABILITADAS="false"

# --- Seed (solo para `npx prisma db seed`) ----------------------------------
# Las sucursales de la cadena, separadas por coma. PENDIENTE de confirmar.
SEED_SEDES="San Martín,Ciudad,Godoy Cruz"

# El dueño: ve las tres sedes y elige sobre cuál trabaja.
SEED_DUENIO_DNI=""
SEED_DUENIO_PASSWORD=""
SEED_DUENIO_NOMBRE="Kevin"
SEED_DUENIO_APELLIDO="Total Fit"

# Un admin por sede. El DNI de cada uno es este número + su posición: con
# 20000001 y tres sedes salen 20000001, 20000002 y 20000003.
SEED_ADMIN_DNI=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NOMBRE="Admin"

# --- Supabase Storage (rutinas) ---------------------------------------------
# Sin prefijo NEXT_PUBLIC_ a propósito: el navegador nunca habla con Supabase.
# La rutina se pide a /api/mi-rutina y el servidor la baja del bucket. La
# service_role key es acceso total al proyecto — si llegara al bundle del
# cliente, cualquiera con el inspector abierto tendría la base entera.
#
# El bucket se crea a mano en el panel de Supabase y va marcado PRIVADO.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="rutinas"
